# Copy this file to `.env.local` and fill in the values you need.
# Vite only exposes variables prefixed with VITE_ to the browser bundle —
# never put secrets or private API keys here.

# Workshop / waitlist registration endpoint.
# The registration form POSTs the form data as JSON to this URL when it is
# set. Any form backend that accepts a JSON POST works, for example:
#   Formspree:   https://formspree.io/f/yourFormId
#   Getform:     https://getform.io/f/yourFormId
#   Basin:       https://usebasin.com/f/yourFormId
#   Your own API / serverless function URL
# While this is empty the form validates input but clearly reports that
# registration is not connected yet — it never claims a submission was saved.
VITE_REGISTRATION_ENDPOINT=

# Optional: a real checkout URL (payment provider link, Gumroad/Lemon Squeezy
# product page, etc.). When set, the cart's checkout button hands the visitor
# off to this URL. When empty, checkout shows an honest "payments not
# configured" notice instead of pretending to take payment.
VITE_CHECKOUT_URL=
